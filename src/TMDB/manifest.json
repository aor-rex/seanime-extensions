  "website": "https://github.com/aor-rex/seanime-extensions",
  "readme": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/TMDB/main.ts",
  "isDevelopment": false,
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "name": "api-key",
        "label": "TMDB API Key",
        "type": "text",
        "default": ""
