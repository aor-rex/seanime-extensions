{
  "id": "torrentio",
  "name": "Torrentio",
  "version": "0.1.3",
  "manifestURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/Torrentio/manifest.json",
  "language": "typescript",
  "type": "anime-torrent-provider",
  "description": "Uses Torrentio to find anime torrents. Supports TMDB custom-source media via IMDb resolution.",
  "author": "aor-rex (fork of Crashdaemon)",
  "icon": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/Torrentio/icon.png",
  "lang": "multi",
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "type": "text",
        "name": "torrentioConfig",
        "label": "Torrentio options (advanced, optional)",
        "default": ""
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/Torrentio/main.ts"
}
