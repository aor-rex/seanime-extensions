{
  "id": "torrentiov2",
  "name": "Torrentio V2",
  "version": "2.2.4",
  "manifestURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/Torrentio/manifest.json",
  "language": "typescript",
  "type": "anime-torrent-provider",
  "description": "Uses Torrentio to find anime torrents. Supports TMDB custom-source media via IMDb resolution.",
  "author": "aor-rex",
  "icon": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/Torrentio/icon.png",
  "lang": "multi",
  "userConfig": {
    "version": 2,
    "requiresConfig": false,
    "fields": [
      {
        "type": "select",
        "name": "torrentioSort",
        "label": "Sorting",
        "default": "quality",
        "options": [
          { "label": "By quality then seeders", "value": "quality" },
          { "label": "By quality then size", "value": "qualitysize" },
          { "label": "By seeders", "value": "seeders" },
          { "label": "By size", "value": "size" }
        ]
      },
      {
        "type": "text",
        "name": "torrentioLimit",
        "label": "Max Results per Quality (1-999, empty = all results)",
        "default": ""
      },
      {
        "type": "text",
        "name": "torrentioLanguage",
        "label": "Priority Language (comma separated, e.g. japanese, russian, latino)",
        "default": ""
      },
      {
        "type": "text",
        "name": "torrentioQualityfilter",
        "label": "Exclude Resolutions (comma separated:4k,1080p,720p,480p,other,scr,cam,unknown)",
        "default": ""
      },
      {
        "type": "text",
        "name": "torrentioSizefilter",
        "label": "Video Size Limit (e.g. 2GB, 500MB; comma = movies,series)",
        "default": ""
      },
      {
        "type": "text",
        "name": "torrentioProviders",
        "label": "Providers (comma separated, empty = all, e.g. 1337x, nyaasi, thepiratebay)",
        "default": ""
      },
      {
        "type": "text",
        "name": "torrentioTmdbApiKey",
        "label": "TMDB API Key (optional; enables title-based IMDb fallback for new series)",
        "default": ""
      },
      {
        "type": "select",
        "name": "torrentioDebrid",
        "label": "Debrid Provider",
        "default": "none",
        "options": [
          { "label": "None", "value": "none" },
          { "label": "RealDebrid", "value": "realdebrid" },
          { "label": "Premiumize", "value": "premiumize" },
          { "label": "AllDebrid", "value": "alldebrid" },
          { "label": "DebridLink", "value": "debridlink" },
          { "label": "EasyDebrid", "value": "easydebrid" },
          { "label": "OffCloud", "value": "offcloud" },
          { "label": "TorBox", "value": "torbox" },
          { "label": "Putio", "value": "putio" }
        ]
      },
      {
        "type": "text",
        "name": "torrentioDebridKey",
        "label": "Debrid API Key (putio: clientId@token)",
        "default": ""
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/Torrentio/main.ts"
}
