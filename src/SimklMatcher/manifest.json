{
  "id": "simkl-matcher",
  "name": "Simkl Matcher",
  "version": "1.0.4",
  "manifestURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/SimklMatcher/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Automatically resolve seanime's unmatched movies/series by searching SIMKL and matching them with one click. Skips anime.",
  "author": "aor-rex",
  "icon": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/SimklMatcher/icon.jpg",
  "website": "https://github.com/aor-rex/seanime-extensions",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/SimklMatcher/main.ts",
  "isDevelopment": false,
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "name": "server-base-url",
        "label": "Seanime server base URL",
        "type": "text",
        "default": "http://127.0.0.1:43211"
      },
      {
        "name": "client-id",
        "label": "SIMKL Client ID (API key) - the same one used by SIMKL V2",
        "type": "text",
        "default": ""
      }
    ]
  },
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["system", "storage"],
      "allow": {
        "networkAccess": {
          "allowedDomains": ["127.0.0.1", "localhost"]
        }
      }
    }
  }
}