{
  "id": "ui-translation",
  "name": "UI Translation",
  "version": "1.4.5",
  "manifestURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/UI-Translation/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Translates Seanime UI into +10 different languages.",
  "author": "aor-rex",
  "icon": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/UI-Translation/icon.png",
  "website": "https://github.com/aor-rex/seanime-extensions",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/aor-rex/seanime-extensions/master/src/UI-Translation/ui-translation.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["storage"],
      "allow": {
        "unsafeFlags": [{"flag": "dom-script-manipulation", "reason": "required for the plugin to work"}]
      }
    }
  },
  "isDevelopment": false
}